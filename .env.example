# ===========================================================================
# ORTAM DEĞİŞKENLERİ REFERANS DOSYASI
#
# Bu dosya YALNIZCA dokümantasyondur ve versiyonlanır.
# Gerçek değerler her uygulamanın kendi .env dosyasına yazılır ve .gitignore
# tarafından ignore edilir. Buraya gerçek bir key veya URL yazmayın.
#
# Kullanım:
#   cp backend/.env.example  backend/.env
#   cp frontend/.env.example frontend/.env
# ===========================================================================


# ---------------------------------------------------------------------------
# BACKEND  ->  backend/.env
# ---------------------------------------------------------------------------
# Zorunlu olanlar: NODE_ENV, PORT, CORS_ORIGIN
#   Eksik bir zorunlu değişken olduğunda backend başlamayı reddeder ve
#   hangi değişkenlerin eksik olduğunu tek seferde listeler.

# Uygulama ortamı: development | test | production
NODE_ENV=development

# Backend'in dinleyeceği port (1-65535)
PORT=3000

# Dinlenen adres.
#   127.0.0.1 -> yalnızca bu makineden erişilir (geliştirme için önerilen)
#   0.0.0.0   -> yerel ağdaki diğer cihazlardan da erişilir
HOST=127.0.0.1

# CORS izin listesi. Birden fazla origin için virgülle ayırın.
# Frontend Vite geliştirme sunucusu varsayılan olarak 5173 portundadır.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Log seviyesi: debug | info | warn | error
LOG_LEVEL=info


# --- Supabase --------------------------------------------------------------
# Bu aşamada ZORUNLU DEĞİLDİR. Supabase değişkenleri boş bırakılırsa
# backend sorunsuz çalışır ve /api/health "not_configured" döner.
# Veritabanı şeması bir sonraki aşamada tasarlanacaktır.
#
# GÜVENLİK UYARISI:
#   SUPABASE_SERVICE_ROLE_KEY sunucu anahtarıdır; tüm veritabanı kurallarını
#   (RLS) atlatır. SADECE backend içinde kullanılmalı, ASLA frontend'e
#   verilmemeli ve ASLA repository'ye yazılmamalıdır.
#   Frontend tarafında kullanıcı doğrulama ileride auth katmanıyla yapılacaktır.

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=


# ---------------------------------------------------------------------------
# FRONTEND  ->  frontend/.env
# ---------------------------------------------------------------------------
# Tüm frontend değişkenleri VITE_ önekiyle başlamak ZORUNDADIR.
# Vite, bu önekle başlamayan değişkenleri tarayıcıya sızdırmaz.
#
# Supabase anahtarları frontend'e YAZILMAZ.

# Backend API adresi.
#   /api -> tarayıcı isteğini aynı origin üzerinden yollar; Vite geliştirme
#           sunucusu bunu backend'e proxy'ler, böylece CORS'a gerek kalmaz.
VITE_API_BASE_URL=/api

# Uygulama adı (document.title ve UI metinleri için)
VITE_APP_NAME=Wagner Kablo Personel Sistemi


# ---------------------------------------------------------------------------
# GELİŞTİRME SUNUCUSU (isteğe bağlı, root .env)
# ---------------------------------------------------------------------------
# Frontend'in /api isteklerini proxy'leyeceği backend adresi.
# Tanımlanmazsa http://localhost:3000 kullanılır.
# Bu değer kaynak koda gömülmez, yalnızca vite.config.ts içinde okunur.
BACKEND_ORIGIN=http://localhost:3000
