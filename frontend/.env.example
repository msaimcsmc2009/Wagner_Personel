# ===========================================================================
# FRONTEND ORTAM DEĞİŞKENLERİ
#
# Bu dosyayı kopyalayıp .env olarak kaydedin:
#   cp .env.example .env
#
# .env dosyası .gitignore tarafından ignore edilir ve ASLA commit edilmez.
# ===========================================================================

# --- ZORUNLU KURAL --------------------------------------------------------
# Tarayıcıya sızan tüm değişkenler "VITE_" önekiyle başlamalıdır.
# Bu öneki taşımayan değişkenler build çıktısına girmez.
# ---------------------------------------------------------------------------

# Backend API adresi
VITE_API_BASE_URL=/api

# Uygulama adı
VITE_APP_NAME=Wagner Kablo Personel Sistemi

# Supabase (PUBLIC)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=