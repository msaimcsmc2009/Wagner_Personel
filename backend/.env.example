# ===========================================================================
# BACKEND ORTAM DEĞİŞKENLERİ
#
# Bu dosyayı kopyalayıp .env olarak kaydedin:
#   cp .env.example .env
#
# .env dosyası .gitignore tarafından ignore edilir ve ASLA commit edilmez.
# Bu örnek dosya (.env.example) versiyonlanır.
# ===========================================================================

NODE_ENV=development
PORT=3000
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=info

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Bootstrap admin: Supabase Auth > Users ile kullanıcı oluştur, sonra
# profiles tablosunda role='admin' ata. Public signup KAPALI.
# Public signup KAPALI tutulur.
# İlk admin hesabı Supabase Auth üzerinden manuel oluşturulur, ardından
# migration'lar uygulanır ve README'deki "İlk yöneticiyi atama" SQL'i
# çalıştırılır. Yeni kullanıcıların profili handle_new_user trigger'ı ile
# otomatik açılır ve role='user' olur.